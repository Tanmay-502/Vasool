ENV=development
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/vasool?sslmode=require
# Comma-separated browser origins in production. Keep '*' only for a public development/demo deployment.
CORS_ORIGINS=*
# Required in production for POST state-changing endpoints. Supports X-API-Key or Authorization: Bearer <key>.
VASOOL_API_KEY=replace_with_long_random_secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
GEMINI_API_KEY_2=optional_secondary_key
GEMINI_API_KEY_3=optional_tertiary_key
GROQ_API_KEY=xxxxxxxxxxxxxxxx
AUTO_PROCESS_ENABLED=true
AUTO_PROCESS_INTERVAL_SECONDS=60
RETRY_LATER_DELAY_MINUTES=30
# Emergency startup floor; once true, runtime API cannot resume automation.
KILL_SWITCH_ENGAGED=false
